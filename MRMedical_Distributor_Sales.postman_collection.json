{
	"info": {
		"_postman_id": "a1b2c3d4-e5f6-7a8b-9c0d-1e2f3a4b5c6d",
		"name": "MRMedical Distributor Sales API",
		"description": "Postman collection for uploading sales spreadsheets and viewing sales records.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Upload Sales Excel",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Authorization",
						"value": "Bearer {{token}}",
						"type": "text"
					}
				],
				"body": {
					"mode": "formdata",
					"formdata": [
						{
							"key": "distributorName",
							"value": "My Test Distributor",
							"type": "text"
						},
						{
							"key": "file",
							"type": "file",
							"description": "The Excel file (sample_sales.xlsx)"
						},
						{
							"key": "salesDate",
							"value": "2026-06-13",
							"type": "text",
							"description": "Optional default sales date (YYYY-MM-DD)",
							"disabled": true
						}
					]
				},
				"url": {
					"raw": "{{baseUrl}}/api/v1/mr/distributors/sales/upload",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"api",
						"v1",
						"mr",
						"distributors",
						"sales",
						"upload"
					]
				}
			},
			"response": []
		},
		{
			"name": "Get Distributor Sales",
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "Authorization",
						"value": "Bearer {{token}}",
						"type": "text"
					}
				],
				"url": {
					"raw": "{{baseUrl}}/api/v1/mr/distributors/sales?startDate=2026-06-01&endDate=2026-06-30",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"api",
						"v1",
						"mr",
						"distributors",
						"sales"
					],
					"query": [
						{
							"key": "distributorId",
							"value": "GMPY-DST-2026-0001",
							"description": "Optional: Filter by Distributor ID",
							"disabled": true
						},
						{
							"key": "startDate",
							"value": "2026-06-01",
							"description": "Optional: Filter by Start Date (YYYY-MM-DD)"
						},
						{
							"key": "endDate",
							"value": "2026-06-30",
							"description": "Optional: Filter by End Date (YYYY-MM-DD)"
						}
					]
				}
			},
			"response": []
		},
		{
			"name": "Get Distributors List",
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "Authorization",
						"value": "Bearer {{token}}",
						"type": "text"
					}
				],
				"url": {
					"raw": "{{baseUrl}}/api/v1/mr/distributors",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"api",
						"v1",
						"mr",
						"distributors"
					]
				}
			},
			"response": []
		}
	],
	"event": [
		{
			"listen": "prerequest",
			"script": {
				"type": "text/javascript",
				"exec": [
					""
				]
			}
		},
		{
			"listen": "test",
			"script": {
				"type": "text/javascript",
				"exec": [
					""
				]
			}
		}
	],
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:8080",
			"type": "string"
		},
		{
			"key": "token",
			"value": "YOUR_JWT_TOKEN_HERE",
			"type": "string"
		}
	]
}
